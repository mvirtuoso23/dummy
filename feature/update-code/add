import java.util.Random;

public class AddTwoDigitNumbers {

    public static void main(String[] args) {
        Random random = new Random();

        // Generate two random two-digit numbers
        int num1 = random.nextInt(90) + 10; // Generates a number between 10 and 99
        int num2 = random.nextInt(90) + 10; // Generates a number between 10 and 99

        // Add the numbers
        int sum = num1 + num2;

        // Print the result
        System.out.println(num1 + " + " + num2 + " = " + sum);
    }
}